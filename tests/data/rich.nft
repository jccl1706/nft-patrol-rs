table ip nat {
  chain pre {
    type nat hook prerouting priority dstnat;
    tcp dport 8080 dnat to 10.0.0.2:80
  }
}
table inet t {
  set allowed {
    type ipv4_addr; flags interval
    elements = { 10.0.0.0/8, 1.2.3.4 }
  }
  chain input {
    type filter hook input priority 0; policy accept;
    ip saddr @allowed tcp dport { 80, 443, 8000-8100 } ct state new counter accept
    iifname "wg0" jump wg
    udp dport 53 log prefix "x " drop
    tcp flags syn tcp dport != 22 reject with tcp reset
    ip6 saddr != fe80::/10 udp dport 5353 accept
  }
  chain wg {
    tcp dport 9000 accept
    return
  }
}
